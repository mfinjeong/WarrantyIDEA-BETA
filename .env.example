# Copy to .env.production on the VPS. Never commit that file.
# Runtime role: DML only, no schema ownership, no superuser/role/database creation.
DATABASE_URL="postgresql://warrantyidea_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/webapp_db?schema=warrantyidea"
# Migration role: owns ONLY warrantyidea schema. Keep out of the running app env.
# Supply this only to the migration command via a separate secured env file.
MIGRATION_DATABASE_URL="postgresql://warrantyidea_migrator:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/webapp_db?schema=warrantyidea"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Production MUST use the exact HTTPS public origin (no path or trailing slash).
BETTER_AUTH_URL="https://warranty.example.com"
# Production auth requires proof from the approved loopback reverse proxy.
# Generate independently; proxy MUST overwrite X-Real-IP and this server-only header:
# X-WarrantyIDEA-Proxy-Secret. Never send this secret from browser/client code.
TRUSTED_PROXY_SECRET="REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# Calendar-day business timezone; use the same timezone in deployment and tests.
APP_TIMEZONE="Asia/Jakarta"
NODE_ENV="production"
