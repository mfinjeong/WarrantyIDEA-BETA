generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["warrantyidea"]
}

enum Role {
  buyer
  admin

  @@schema("warrantyidea")
}

enum Category {
  electronics
  home
  other

  @@schema("warrantyidea")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@schema("warrantyidea")
}

model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  image         String?
  role          Role             @default(buyer)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sessions      Session[]
  accounts      Account[]
  settings      UserSettings?
  warranties    Warranty[]
  purchases     Purchase[]
  notifications Notification[]
  activity      ReviewActivity[]

  @@schema("warrantyidea")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("warrantyidea")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@schema("warrantyidea")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@schema("warrantyidea")
}

model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@schema("warrantyidea")
}

model UserSettings {
  userId    String  @id
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Boolean @default(true)

  @@schema("warrantyidea")
}

model Product {
  id          String     @id @default(uuid())
  name        String
  brand       String
  model       String
  category    Category
  fingerprint String     @unique
  purchases   Purchase[]

  @@schema("warrantyidea")
}

model CatalogProduct {
  id             String   @id @default(uuid())
  name           String
  brand          String
  model          String
  category       Category
  brandModelKey  String   @unique
  warrantyMonths Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("warrantyidea")
}

model Purchase {
  id           String    @id @default(uuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  store        String
  purchaseDate DateTime  @db.Date
  price        BigInt?
  warranty     Warranty?

  @@index([ownerId])
  @@schema("warrantyidea")
}

model Warranty {
  id           String           @id @default(uuid())
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purchaseId   String           @unique
  purchase     Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  serialNumber String
  serialKey    String
  expiryDate   DateTime         @db.Date
  notes        String           @default("")
  reviewStatus ReviewStatus     @default(pending)
  reviewNote   String?
  revision     Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  activities   ReviewActivity[]

  @@unique([ownerId, serialKey])
  @@index([ownerId, expiryDate])
  @@index([reviewStatus, createdAt])
  @@schema("warrantyidea")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience  Role
  title     String
  body      String
  href      String?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, audience, createdAt])
  @@schema("warrantyidea")
}

model ReviewActivity {
  id         String       @id @default(uuid())
  actorId    String
  actor      User         @relation(fields: [actorId], references: [id])
  warrantyId String?
  warranty   Warranty?    @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  ownerId    String
  status     ReviewStatus
  note       String?
  text       String
  createdAt  DateTime     @default(now())

  @@index([ownerId, createdAt])
  @@schema("warrantyidea")
}
